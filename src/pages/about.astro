---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const about = await getEntry('pages', 'about');

if (!about) {
  throw new Error('找不到 src/content/pages/about.md');
}

const { Content } = await render(about);
---

<BaseLayout title={about.data.title} description={about.data.description ?? SITE.description}>
  <article class="about-page">
    <header class="page-header about-heading">
      <h1>{about.data.title}</h1>
    </header>

    <div class="prose about-prose">
      <Content />
    </div>
  </article>
</BaseLayout>
