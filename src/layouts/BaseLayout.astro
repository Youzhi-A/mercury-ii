---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { sitePath } from '../utils/urls';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  type = 'website',
} = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} | ${SITE.shortTitle}`;
const canonicalURL = new URL(sitePath(Astro.url.pathname), Astro.site ?? SITE.url);
const imageURL = image ? new URL(sitePath(image), Astro.site ?? SITE.url) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef2f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101617" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={sitePath('/favicon.png')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={sitePath('/rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="site-shell">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
