---
import type { Post } from '../utils/posts';
import { formatDate } from '../utils/posts';
import { sitePath } from '../utils/urls';

interface Props {
  posts: Post[];
  empty?: string;
}

const { posts, empty = '这里暂时还没有文章。' } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty-state">{empty}</p>
) : (
  <ol class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-link" href={sitePath(`/posts/${post.id}/`)}>
          <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <div class="post-copy">
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <ul class="inline-tags" aria-label="文章栏目和标签">
              <li class="post-category">{post.data.category}</li>
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </a>
      </li>
    ))}
  </ol>
)}
